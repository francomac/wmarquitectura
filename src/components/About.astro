---
import type { Lang } from '../lib/site';
import { SITE } from '../lib/site';
import { t } from '../i18n/ui';
import { localePath } from '../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = localePath(lang);
---

<section id="estudio" class="bg-paper-soft">
  <div class="container-w pt-14 pb-20 sm:pt-20 sm:pb-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <figure class="relative">
          <div class="aspect-[3/2] w-full overflow-hidden bg-ink/5">
            <img
              src="/images/estudio-boceto.jpg"
              alt="William Martínez Sandoval dibujando a mano alzada el boceto de una casa junto a sus clientes"
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
          <figcaption class="mt-4 font-mono text-fluid-xs uppercase tracking-[0.18em] text-ink-muted">
            Estudio — {SITE.base}
          </figcaption>
        </figure>
      </div>

      <div class="lg:col-span-6 flex flex-col justify-center">
        <span class="eyebrow">
          <span class="eyebrow-num">[01]</span>
          {t('about.title', lang)}
        </span>
        <h1 class="mt-6 h-section text-balance">{t('about.title', lang)}</h1>
        <p class="mt-8 lead text-pretty">
          {t('about.body', lang)}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={`${home}#obras`} class="btn-primary">{t('about.ctaProjects', lang)} <span aria-hidden="true">↓</span></a>
          <a href={`${home}#contacto`} class="btn-ghost">{t('about.ctaContact', lang)}</a>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-ink/15 pt-10 sm:grid-cols-3 sm:max-w-xl">
          <div>
            <dt class="font-mono text-fluid-xs uppercase tracking-eyebrow text-ink-muted">Base</dt>
            <dd class="mt-2 font-display text-fluid-base text-ink">{SITE.base}</dd>
          </div>
          <div>
            <dt class="font-mono text-fluid-xs uppercase tracking-eyebrow text-ink-muted">Región</dt>
            <dd class="mt-2 font-display text-fluid-base text-ink">{SITE.region}</dd>
          </div>
          <div>
            <dt class="font-mono text-fluid-xs uppercase tracking-eyebrow text-ink-muted">Desde</dt>
            <dd class="mt-2 font-display text-fluid-base text-ink">{SITE.yearFounded}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
